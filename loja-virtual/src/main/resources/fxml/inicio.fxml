<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="br.com.lojavirtual.ui.InicioController" styleClass="login-fundo">
   <fx:define>
      <ToggleGroup fx:id="grupoPerfil" />
   </fx:define>
   <children>
      <!-- enfeites abstratos de fundo -->
      <Circle mouseTransparent="true" radius="240.0" styleClass="login-circulo" translateX="-160.0"
              translateY="-170.0" StackPane.alignment="TOP_LEFT" />
      <Circle mouseTransparent="true" radius="190.0" styleClass="login-circulo-2" translateX="120.0"
              translateY="130.0" StackPane.alignment="BOTTOM_RIGHT" />

      <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="440.0" minWidth="340.0" spacing="14.0"
            styleClass="login-card">
         <padding>
            <Insets bottom="32.0" left="36.0" right="36.0" top="32.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" spacing="10.0">
               <children>
                  <StackPane styleClass="marca-logo">
                     <children>
                        <Region styleClass="icone, icone-raio, icone-branco" />
                     </children>
                  </StackPane>
                  <Label styleClass="marca-nome-escuro" text="Loja" />
                  <Label styleClass="marca-nome-destaque" text="Virtual">
                     <HBox.margin>
                        <Insets left="-8.0" />
                     </HBox.margin>
                  </Label>
               </children>
            </HBox>
            <Label styleClass="titulo-medio" text="Bem-vindo!">
               <VBox.margin>
                  <Insets top="6.0" />
               </VBox.margin>
            </Label>
            <Label styleClass="texto-suave" text="Entre para fazer suas compras ou gerenciar a loja." wrapText="true"
                   textAlignment="CENTER" />

            <HBox spacing="4.0" styleClass="segmentos">
               <children>
                  <ToggleButton fx:id="abaComprador" maxWidth="Infinity" selected="true" styleClass="segmento"
                                text="Sou comprador" toggleGroup="$grupoPerfil" HBox.hgrow="ALWAYS" />
                  <ToggleButton fx:id="abaAdmin" maxWidth="Infinity" styleClass="segmento" text="Sou administrador"
                                toggleGroup="$grupoPerfil" HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <StackPane>
               <children>
                  <VBox fx:id="formComprador" spacing="8.0">
                     <children>
                        <Label styleClass="rotulo-campo" text="Seu nome" />
                        <TextField fx:id="campoNome" onAction="#entrarComoComprador" promptText="Como podemos te chamar?" />
                        <Label fx:id="erroNome" styleClass="msg-erro" wrapText="true" />
                        <Label styleClass="texto-pequeno" wrapText="true"
                               text="Usamos apenas o seu nome para identificar o seu histórico de compras." />
                        <Button maxWidth="Infinity" onAction="#entrarComoComprador" styleClass="botao-primario"
                                text="Entrar como comprador">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                           <graphic>
                              <Region styleClass="icone, icone-carrinho" />
                           </graphic>
                        </Button>
                     </children>
                  </VBox>
                  <VBox fx:id="formAdmin" managed="false" spacing="8.0" visible="false">
                     <children>
                        <Label styleClass="rotulo-campo" text="Senha do administrador" />
                        <PasswordField fx:id="campoSenha" onAction="#entrarComoAdmin" promptText="Digite a senha" />
                        <Label fx:id="erroSenha" styleClass="msg-erro" wrapText="true" />
                        <Button maxWidth="Infinity" onAction="#entrarComoAdmin" styleClass="botao-primario"
                                text="Entrar como administrador">
                           <VBox.margin>
                              <Insets top="6.0" />
                           </VBox.margin>
                           <graphic>
                              <Region styleClass="icone, icone-cadeado" />
                           </graphic>
                        </Button>
                     </children>
                  </VBox>
               </children>
            </StackPane>
            <Button maxWidth="Infinity" onAction="#fecharPrograma" styleClass="botao-secundario"
                    text="Fechar o programa">
               <graphic>
                  <Region styleClass="icone, icone-fechar" />
               </graphic>
            </Button>
         </children>
      </VBox>
   </children>
</StackPane>
