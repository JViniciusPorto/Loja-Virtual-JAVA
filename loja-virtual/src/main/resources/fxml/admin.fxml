<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.com.lojavirtual.ui.AdminController">

   <!-- ============================ BARRA SUPERIOR ============================ -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="14.0" styleClass="topbar">
         <padding>
            <Insets bottom="12.0" left="20.0" right="20.0" top="12.0" />
         </padding>
         <children>
            <StackPane styleClass="marca-logo">
               <children>
                  <Region styleClass="icone, icone-raio, icone-branco" />
               </children>
            </StackPane>
            <HBox alignment="CENTER_LEFT" spacing="2.0">
               <children>
                  <Label styleClass="marca-nome" text="Loja" />
                  <Label styleClass="marca-nome-destaque" text="Virtual" />
               </children>
            </HBox>
            <Label styleClass="topbar-titulo" text="Painel do administrador" />
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#sair" styleClass="botao-topo" text="Sair">
               <graphic>
                  <Region styleClass="icone, icone-sair" />
               </graphic>
            </Button>
         </children>
      </HBox>
   </top>

   <!-- ============================== MENU LATERAL ============================== -->
   <left>
      <VBox prefWidth="210.0" minWidth="210.0" maxWidth="210.0" spacing="6.0" styleClass="sidebar">
         <padding>
            <Insets bottom="16.0" left="12.0" right="12.0" top="18.0" />
         </padding>
         <children>
            <Label styleClass="sidebar-rotulo" text="GESTÃO" />
            <Button maxWidth="Infinity" onAction="#novo" styleClass="menu-item, ativo" text="Produtos">
               <graphic>
                  <Region styleClass="icone, icone-caixa" />
               </graphic>
            </Button>
            <Region VBox.vgrow="ALWAYS" />
            <Button maxWidth="Infinity" onAction="#sair" styleClass="menu-item" text="Sair">
               <graphic>
                  <Region styleClass="icone, icone-sair" />
               </graphic>
            </Button>
         </children>
      </VBox>
   </left>

   <!-- ================================ CONTEÚDO ================================ -->
   <center>
      <StackPane fx:id="areaCentral">
         <children>
            <ScrollPane fx:id="rolagem" fitToWidth="true" hbarPolicy="NEVER"
                        styleClass="pagina-scroll">
               <content>
                  <VBox spacing="20.0" styleClass="pagina">
                     <padding>
                        <Insets bottom="28.0" left="28.0" right="28.0" top="24.0" />
                     </padding>
                     <children>
                        <VBox spacing="2.0">
                           <children>
                              <Label styleClass="titulo-pagina" text="Gerenciamento de produtos" />
                              <Label styleClass="texto-suave"
                                     text="Cadastre, edite e remova os produtos que aparecem na loja." />
                           </children>
                        </VBox>

                        <!-- indicadores (calculados a partir dos produtos cadastrados) -->
                        <FlowPane hgap="16.0" vgap="16.0">
                           <children>
                              <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="14.0" styleClass="stat-card">
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                                 <children>
                                    <StackPane styleClass="circulo-icone">
                                       <children>
                                          <Region styleClass="icone, icone-caixa, icone-g" />
                                       </children>
                                    </StackPane>
                                    <VBox>
                                       <children>
                                          <Label fx:id="statProdutos" styleClass="stat-valor" />
                                          <Label styleClass="stat-rotulo" text="Produtos cadastrados" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="14.0" styleClass="stat-card">
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                                 <children>
                                    <StackPane styleClass="circulo-icone">
                                       <children>
                                          <Region styleClass="icone, icone-grade, icone-g" />
                                       </children>
                                    </StackPane>
                                    <VBox>
                                       <children>
                                          <Label fx:id="statUnidades" styleClass="stat-valor" />
                                          <Label styleClass="stat-rotulo" text="Unidades em estoque" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="14.0" styleClass="stat-card">
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                                 <children>
                                    <StackPane styleClass="circulo-icone">
                                       <children>
                                          <Region styleClass="icone, icone-dinheiro, icone-g" />
                                       </children>
                                    </StackPane>
                                    <VBox>
                                       <children>
                                          <Label fx:id="statValorEstoque" styleClass="stat-valor" />
                                          <Label styleClass="stat-rotulo" text="Valor do estoque" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT" prefWidth="240.0" spacing="14.0" styleClass="stat-card">
                                 <padding>
                                    <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
                                 </padding>
                                 <children>
                                    <StackPane styleClass="circulo-icone">
                                       <children>
                                          <Region styleClass="icone, icone-alerta, icone-g" />
                                       </children>
                                    </StackPane>
                                    <VBox>
                                       <children>
                                          <Label fx:id="statEstoqueBaixo" styleClass="stat-valor" />
                                          <Label fx:id="rotuloEstoqueBaixo" styleClass="stat-rotulo" />
                                       </children>
                                    </VBox>
                                 </children>
                              </HBox>
                           </children>
                        </FlowPane>

                        <!-- tabela + formulário (o formulário desce para baixo da tabela em janelas estreitas) -->
                        <GridPane fx:id="colunas" hgap="20.0" vgap="20.0" VBox.vgrow="ALWAYS">
                           <columnConstraints>
                              <ColumnConstraints hgrow="ALWAYS" minWidth="320.0" />
                              <ColumnConstraints hgrow="NEVER" minWidth="300.0" prefWidth="330.0" />
                           </columnConstraints>
                           <rowConstraints>
                              <RowConstraints minHeight="380.0" vgrow="ALWAYS" />
                           </rowConstraints>
                           <children>
                              <VBox fx:id="cartaoTabela" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                                       <children>
                                          <Label styleClass="titulo-secao" text="Produtos cadastrados" />
                                          <Label fx:id="labelTotal" styleClass="texto-suave" />
                                       </children>
                                    </HBox>
                                    <TableView fx:id="tabela" minHeight="300.0" VBox.vgrow="ALWAYS">
                                       <columns>
                                          <TableColumn fx:id="colId" text="ID" />
                                          <TableColumn fx:id="colNome" text="NOME" />
                                          <TableColumn fx:id="colPreco" text="PREÇO" />
                                          <TableColumn fx:id="colEstoque" text="ESTOQUE" />
                                          <TableColumn fx:id="colAcoes" text="AÇÕES" />
                                       </columns>
                                       <placeholder>
                                          <Label text="Nenhum produto cadastrado." />
                                       </placeholder>
                                    </TableView>
                                 </children>
                              </VBox>
                              <VBox fx:id="cartaoFormulario" maxHeight="-Infinity" spacing="8.0" styleClass="cartao"
                                    GridPane.columnIndex="1" GridPane.rowIndex="0" GridPane.valignment="TOP">
                                 <padding>
                                    <Insets bottom="22.0" left="22.0" right="22.0" top="22.0" />
                                 </padding>
                                 <children>
                                    <Label fx:id="labelModo" styleClass="titulo-secao" text="Novo produto" />
                                    <Label styleClass="rotulo-campo" text="Nome">
                                       <VBox.margin>
                                          <Insets top="6.0" />
                                       </VBox.margin>
                                    </Label>
                                    <TextField fx:id="campoNome" onAction="#salvar" promptText="Ex.: Mouse Gamer" />
                                    <Label styleClass="rotulo-campo" text="Preço (R$)" />
                                    <TextField fx:id="campoPreco" onAction="#salvar" promptText="Ex.: 89,90" />
                                    <Label styleClass="rotulo-campo" text="Estoque" />
                                    <TextField fx:id="campoEstoque" onAction="#salvar" promptText="Ex.: 10" />
                                    <Label styleClass="rotulo-campo" text="Foto do produto" />
                                    <StackPane fx:id="previaFoto" maxHeight="120.0" minHeight="120.0" prefHeight="120.0" />
                                    <HBox spacing="8.0">
                                       <children>
                                          <Button fx:id="botaoEscolherFoto" maxWidth="Infinity" onAction="#escolherFoto"
                                                  styleClass="botao-secundario" text="Escolher foto" HBox.hgrow="ALWAYS">
                                             <graphic>
                                                <Region styleClass="icone, icone-imagem" />
                                             </graphic>
                                          </Button>
                                          <Button fx:id="botaoRemoverFoto" onAction="#removerFoto"
                                                  styleClass="botao-icone, botao-icone-perigo">
                                             <graphic>
                                                <Region styleClass="icone, icone-lixeira" />
                                             </graphic>
                                          </Button>
                                       </children>
                                    </HBox>
                                    <Label minHeight="-Infinity" styleClass="texto-pequeno" wrapText="true"
                                           text="PNG, JPG, GIF ou BMP, até 8 MB. A foto é copiada para a pasta data/imagens." />
                                    <Button fx:id="botaoSalvar" maxWidth="Infinity" onAction="#salvar"
                                            styleClass="botao-primario" text="Cadastrar produto">
                                       <VBox.margin>
                                          <Insets top="10.0" />
                                       </VBox.margin>
                                       <graphic>
                                          <Region styleClass="icone, icone-check" />
                                       </graphic>
                                    </Button>
                                    <Button maxWidth="Infinity" onAction="#novo" styleClass="botao-secundario"
                                            text="Novo / limpar formulário">
                                       <graphic>
                                          <Region styleClass="icone, icone-mais" />
                                       </graphic>
                                    </Button>
                                    <Button fx:id="botaoRemover" maxWidth="Infinity" onAction="#remover"
                                            styleClass="botao-perigo-suave" text="Remover produto selecionado">
                                       <graphic>
                                          <Region styleClass="icone, icone-lixeira" />
                                       </graphic>
                                    </Button>
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>
                     </children>
                  </VBox>
               </content>
            </ScrollPane>
         </children>
      </StackPane>
   </center>
</BorderPane>
